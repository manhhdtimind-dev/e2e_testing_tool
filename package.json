{
  "name": "e2e-ai-trainer",
  "productName": "E2E AI Trainer",
  "version": "0.1.0",
  "private": true,
  "description": "Công cụ desktop AI Training và chạy web E2E test (Playwright)",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo-site": "node demo-site/server.mjs",
    "e2e:runner": "node scripts/build.mjs && node scripts/e2e-runner-check.mjs",
    "smoke:ui": "node scripts/build.mjs && node scripts/smoke-ui.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.32",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openai/codex-sdk": "0.158.0",
    "@playwright/mcp": "0.0.83",
    "adm-zip": "^0.6.1",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "playwright": "1.63.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.5",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
